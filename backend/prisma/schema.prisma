// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios Portfolio[]
}

model Template {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  category     String
  previewImage String?
  description  String?
  isPremium    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolios Portfolio[]
}

model Portfolio {
  id          String          @id @default(uuid())
  userId      String
  name        String
  slug        String          @unique
  templateId  String
  status      PortfolioStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  profile     PortfolioProfile?
  theme       PortfolioTheme?
  settings    PortfolioSettings?
  domains     Domain[]
  projects    Project[]
  skills      Skill[]
  experiences Experience[]
  educations  Education[]
  socialLinks SocialLink[]

  @@index([userId])
  @@index([templateId])
}

model PortfolioProfile {
  id           String   @id @default(uuid())
  portfolioId  String   @unique
  fullName     String
  headline     String?
  bio          String?  @db.Text
  profileImage String?
  location     String?
  email        String?
  phone        String?
  resumeUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  portfolioId  String
  title        String
  description  String   @db.Text
  image        String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Skill {
  id           String     @id @default(uuid())
  portfolioId  String
  name         String
  category     String?
  level        SkillLevel @default(INTERMEDIATE)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Experience {
  id           String    @id @default(uuid())
  portfolioId  String
  company      String
  role         String
  description  String?   @db.Text
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Education {
  id           String    @id @default(uuid())
  portfolioId  String
  institution  String
  degree       String
  field        String?
  startDate    DateTime
  endDate      DateTime?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model SocialLink {
  id           String   @id @default(uuid())
  portfolioId  String
  platform     String
  url          String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model PortfolioTheme {
  id               String   @id @default(uuid())
  portfolioId      String   @unique
  primaryColor     String   @default("#000000")
  secondaryColor   String   @default("#ffffff")
  backgroundColor  String   @default("#ffffff")
  textColor        String   @default("#000000")
  fontFamily       String   @default("Inter")
  borderRadius     String   @default("0.5rem")
  animationEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model PortfolioSettings {
  id             String   @id @default(uuid())
  portfolioId    String   @unique
  showAbout      Boolean  @default(true)
  showSkills     Boolean  @default(true)
  showProjects   Boolean  @default(true)
  showExperience Boolean  @default(true)
  showEducation  Boolean  @default(true)
  showContact    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  favicon        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Domain {
  id                 String                   @id @default(uuid())
  portfolioId        String
  hostname           String                   @unique
  type               DomainType               @default(SUBDOMAIN)
  verificationStatus DomainVerificationStatus @default(PENDING)
  isPrimary          Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}
